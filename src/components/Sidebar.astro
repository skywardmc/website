---
import { execFileSync } from "node:child_process";
import { existsSync } from "node:fs";
import { Icon } from "astro-icon/components";

const sections = [
	{
		path: "/adrenaline",
		links: [
			{ label: "Home", href: "/adrenaline" },
			{ label: "Installation", href: "/adrenaline/installation" },
			{ label: "Post-install", href: "/adrenaline/post-install" },
			{
				label: "Frequently asked questions",
				href: "/adrenaline/frequently-asked-questions",
			},
			{
				label: "Performance features",
				href: "/adrenaline/performance-features",
			},
			{ label: "Config changes", href: "/adrenaline/config-changes" },
			{ label: "Troubleshooting", href: "/adrenaline/troubleshooting" },
			{ label: "Credits", href: "/adrenaline/credits" },
		],
	},
	{
		path: "/additive",
		links: [
			{ label: "Home", href: "/additive" },
			{ label: "Installation", href: "/additive/installation" },
			{ label: "Post-install", href: "/additive/post-install" },
			{
				label: "Frequently asked questions",
				href: "/additive/frequently-asked-questions",
			},
			{ label: "OptiFine features", href: "/additive/optifine-features" },
			{ label: "Extra features", href: "/additive/extra-features" },
			{ label: "Config changes", href: "/additive/config-changes" },
			{ label: "Troubleshooting", href: "/additive/troubleshooting" },
			{ label: "Supporter cape", href: "/additive/supporter-cape" },
			{ label: "Credits", href: "/additive/credits" },
		],
	},
	{
		path: "/hammer",
		links: [
			{ label: "Home", href: "/hammer" },
			{ label: "Installation", href: "/hammer/installation" },
			{ label: "Post-install", href: "/hammer/post-install" },
			{
				label: "Frequently asked questions",
				href: "/hammer/frequently-asked-questions",
			},
			{ label: "Performance features", href: "/hammer/performance-features" },
			{ label: "Config changes", href: "/hammer/config-changes" },
			{ label: "Troubleshooting", href: "/hammer/troubleshooting" },
		],
	},
	{
		path: "/drill",
		links: [],
	},
];

const sourcePath = ["md", "mdx"]
	.map(
		(extension) =>
			`src/pages/${Astro.url.pathname.replace(/^\/+|\/+$/g, "")}.${extension}`,
	)
	.find((path) => existsSync(path));

let commit: { author: string; date: string; hash: string } | undefined;
if (sourcePath) {
	try {
		const [author, date, hash] = execFileSync(
			"git",
			["log", "-1", "--format=%an%n%aI%n%H", "--", sourcePath],
			{ encoding: "utf8" },
		)
			.trim()
			.split("\n");

		if (author && date && hash) commit = { author, date, hash };
	} catch {}
}
---

<aside
	class="flex flex-col gap-4 md:w-48 p-6 px-4 sm:px-6 md:ps-0 sm:rounded-sm md:rounded-none md:rounded-r-sm bg-skywardmc-white dark:bg-skywardmc-black sm:dark:bg-skywardmc-gray"
	id="sidebar"
>
	<h1 class="text-xl font-bold">Pages</h1>
	<nav class="flex flex-col gap-1">
		{
			sections
				.find((section) =>
					Astro.url.pathname.replace(/\/$/, "").startsWith(section.path),
				)
				?.links.map((link) => (
					<a
						class:list={[
							"p-3 py-1 rounded-xs",
							Astro.url.pathname.replace(/\/$/, "") ===
							link.href.replace(/\/$/, "")
								? "border-s-4 bg-skywardmc-offwhite dark:bg-skywardmc-offgray"
								: "bg-skywardmc-offwhite/60 hover:bg-skywardmc-offwhite dark:bg-skywardmc-offgray/60 dark:hover:bg-skywardmc-offgray",
						]}
						href={link.href}
					>
						{link.label}
					</a>
				))
		}
	</nav>
	{
		sourcePath && (
			<div class="flex flex-col gap-2 text-xs text-end">
				{commit && (
					<a
						href={`https://github.com/skywardmc/skywardmc.org/commit/${commit.hash}`}
						class="opacity-75"
					>
						Last edit: {commit.author}
						<time class="block" datetime={commit.date}>
							{new Date(commit.date).toLocaleString("en-US", {
								dateStyle: "medium",
								timeStyle: "short",
							})}
						</time>
					</a>
				)}
				<a
					href={`https://github.com/skywardmc/skywardmc.org/edit/main/${sourcePath}`}
					class="flex items-center justify-end gap-2 rounded-xs opacity-50"
				>
					<Icon name="lucide:pen-line" />
					Edit this page
				</a>
			</div>
		)
	}
</aside>
